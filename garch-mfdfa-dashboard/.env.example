# Backend environment variables
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# PUBLIC IP or DNS of your EC2 instance — the address you type in the browser to
# open the dashboard. Vite's hot-reload WebSocket must point here, otherwise you get
# "[vite] server connection lost. Polling for restart...". Leave blank for local dev.
# Example: EC2_PUBLIC_HOST=12.34.56.78  or  ec2-12-34-56-78.compute-1.amazonaws.com
EC2_PUBLIC_HOST=

# Optional: cloud credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
