{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.*",
    "vite.config.ts",
    "index.html",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],
  "exclude": ["node_modules"]
}
